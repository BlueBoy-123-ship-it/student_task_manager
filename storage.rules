rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /assignments/{lecturerId}/{assignmentId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == lecturerId
                   && request.resource.contentType == 'application/pdf'
                   && request.resource.size < 10485760;
      allow delete: if request.auth != null && request.auth.uid == lecturerId;
    }

    match /submissions/{studentId}/{assignmentId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == studentId
                   && request.resource.contentType == 'application/pdf'
                   && request.resource.size < 10485760;
      allow delete: if request.auth != null && request.auth.uid == studentId;
    }
  }
}
